          "pattern": "^([a-zA-Z0-9_]+)?$",
          "type": "string"
        },
        "marketPrice": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "timestamp": {
          "description": "Milliseconds as a decimal string representing a safe integer; SDK version is not strategy version.",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "action",
        "version",
        "timestamp"
      ],
      "title": "CancelSignalPayload",
      "type": "object"
    },
