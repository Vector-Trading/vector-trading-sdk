{
  "name": "vector-trading-sdk-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json --noEmit && pnpm --dir typescript typecheck",
    "generation:setup": "node scripts/setup-generation.ts",
    "contracts:check": "node scripts/check-contracts.ts",
    "generate": "node scripts/generate.ts",
    "generated:check": "node scripts/check-generated.ts",
    "test": "vitest run",
    "generation:probe": "node scripts/probe-generation.ts",
    "test:typescript": "pnpm --dir typescript test",
    "build:typescript": "pnpm --dir typescript build",
    "test:typescript:package": "pnpm --dir typescript test:package",
    "test:python": "node scripts/python.ts test",
    "build:python": "node scripts/python.ts build",
    "test:python:package": "node scripts/python.ts package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "yaml": "2.8.1"
  }
}
